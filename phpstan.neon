includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7
    ignoreErrors:
        # Used by the Livewire single-file profile component, outside PHPStan's PHP paths.
        - identifier: trait.unused
          path: app/Concerns/ProfileValidationRules.php
